# ==============================================================================
# MediCore - Environment Configuration Template
# All secrets and external connections are configured here.
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000
ANALYTICS_PORT=8000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Production or Docker PostgreSQL connection string:
DATABASE_URL="postgresql://medicore_user:medicore_secure_password_2026@localhost:5432/medicore_db?schema=public"
# In local development without standalone Postgres daemon, set to "memory" or "local"
DATABASE_MODE=local

# ------------------------------------------------------------------------------
# 3. REDIS & BACKGROUND JOBS (BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# In production, generate cryptographically random 256-bit strings (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET="medicore_jwt_access_secret_sample_key_minimum_32_characters_for_security"
JWT_REFRESH_SECRET="medicore_jwt_refresh_secret_sample_key_minimum_32_characters_for_security"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 5. SERVICE URLS (Cross-Service Communication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_ANALYTICS_URL="http://localhost:8000"
BACKEND_BASE_URL="http://localhost:4000"
ANALYTICS_SERVICE_URL="http://localhost:8000"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 6. HEALTHCARE INTEROPERABILITY (FHIR R4)
# ------------------------------------------------------------------------------
# Public test server or local mock: http://localhost:4000/api/v1/fhir or https://hapi.fhir.org/baseR4
FHIR_BASE_URL="http://localhost:4000/api/v1/fhir"
FHIR_AUTH_TOKEN="medicore-fhir-dev-token"
FHIR_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 7. NOTIFICATION SERVICES (Sandbox Mode)
# ------------------------------------------------------------------------------
# Local Mailpit or SMTP sandbox
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@medicore.health"

# Local SMS Simulator / Twilio Sandbox
SMS_PROVIDER="sandbox" # Options: sandbox, twilio
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid_for_sandbox"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token_for_sandbox"
TWILIO_PHONE_NUMBER="+15005550006"
