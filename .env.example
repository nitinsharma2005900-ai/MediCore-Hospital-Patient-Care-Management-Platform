# Synthetic educational deployment only. Never commit an actual .env.
NODE_ENV=development
PORT=4010
DATABASE_URL=postgresql://medicore:REPLACE_DATABASE_PASSWORD@127.0.0.1:5546/medicore
POSTGRES_USER=medicore
POSTGRES_DB=medicore
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
REDIS_URL=redis://127.0.0.1:6386
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
CORS_ORIGIN=http://localhost:3010,http://127.0.0.1:3010
BACKEND_BASE_URL=http://127.0.0.1:4010
ANALYTICS_SERVICE_URL=http://127.0.0.1:8010
SEED_DEMO=true
RUN_WORKER=true
# Same-origin browser requests are the default. No public localhost URLs in production.
# FHIR is a local authenticated R4-shaped mock; no external API key is required.
FHIR_BASE_URL=http://127.0.0.1:4010/api/v1/fhir
FHIR_AUTH_TOKEN=
# EMAIL and SMS are local, durable simulators; never sent to real recipients.
SMS_PROVIDER=sandbox
