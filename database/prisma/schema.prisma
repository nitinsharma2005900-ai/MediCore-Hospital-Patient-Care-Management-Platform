// MediCore PostgreSQL Relational Schema
// Assessment 03 - Clinical Relational Database
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  BILLING_OFFICER
  ADMIN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentType {
  ROUTINE
  FOLLOW_UP
  EMERGENCY
  SPECIALIST
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  AMBULATORY
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  ADMISSION
  DISCHARGE
}

enum PrescriptionStatus {
  ACTIVE
  FILLED
  DISCONTINUED
  EXPIRED
}

enum LabOrderStatus {
  PENDING
  COLLECTED
  IN_ANALYSIS
  COMPLETED
  CANCELLED
}

enum LabPriority {
  ROUTINE
  URGENT
  STAT
}

enum LabInterpretation {
  NORMAL
  LOW
  HIGH
  CRITICAL
  ABNORMAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum InvoiceCategory {
  CONSULTATION
  LAB_TEST
  MEDICATION
  PROCEDURE
  ROOM_CHARGE
}

enum PaymentMethod {
  CARD
  CASH
  BANK_TRANSFER
  INSURANCE
  SIMULATED
}

enum ConsentType {
  GENERAL_CARE
  CLINICAL_DATA_SHARING
  RESEARCH
  LAB_DATA_ACCESS
  EMERGENCY_OVERRIDE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  role                Role
  firstName           String
  lastName            String
  phone               String?
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  revoked         Boolean   @default(false)
  revokedAt       DateTime?
  replacedByToken String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model Department {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  description  String?
  building     String?
  floor        Int?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  doctors      DoctorProfile[]
  appointments Appointment[]
}

model DoctorProfile {
  id              String               @id @default(uuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department           @relation(fields: [departmentId], references: [id])
  licenseNumber   String               @unique
  specialization  String
  consultationFee Decimal              @default(150.00) @db.Decimal(10, 2)
  roomNumber      String?
  bio             String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  availabilities  DoctorAvailability[]
  appointments    Appointment[]
  encounters      Encounter[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]

  @@index([departmentId])
  @@index([specialization])
}

model DoctorAvailability {
  id                  String        @id @default(uuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int           // 0 = Sunday, 1 = Monday, etc.
  startTime           String        // "09:00"
  endTime             String        // "17:00"
  slotDurationMinutes Int           @default(30)
  timeZone            String        @default("UTC")
  isActive            Boolean       @default(true)

  @@index([doctorId, dayOfWeek])
}

model PatientProfile {
  id                    String          @id @default(uuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mrn                   String          @unique // Medical Record Number
  dateOfBirth           DateTime
  gender                String
  bloodGroup            String?
  emergencyContactName  String
  emergencyContactPhone String
  address               String
  insuranceProvider     String?
  insurancePolicyNumber String?
  allergies             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  appointments          Appointment[]
  encounters            Encounter[]
  vitalSigns            VitalSigns[]
  diagnoses             Diagnosis[]
  prescriptions         Prescription[]
  labOrders             LabOrder[]
  labResults            LabResult[]
  invoices              Invoice[]
  consents              ConsentRecord[]

  @@index([mrn])
}

model Appointment {
  id                 String            @id @default(uuid())
  appointmentNumber  String            @unique
  patientId          String
  patient            PatientProfile    @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id])
  departmentId       String
  department         Department        @relation(fields: [departmentId], references: [id])
  scheduledStartTime DateTime
  scheduledEndTime   DateTime
  status             AppointmentStatus @default(REQUESTED)
  type               AppointmentType   @default(ROUTINE)
  reason             String
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  checkedInAt        DateTime?
  priority           String            @default("NORMAL")
  version            Int               @default(1) // Optimistic concurrency lock
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  encounter          Encounter?

  @@index([patientId])
  @@index([doctorId, scheduledStartTime])
  @@index([status])
}

model WaitingList {
  id             String     @id @default(uuid())
  patientId      String
  doctorId       String?
  departmentId   String
  preferredDate  DateTime
  urgencyLevel   String     @default("MEDIUM")
  status         String     @default("PENDING") // PENDING, OFFERED, CONVERTED, EXPIRED, CANCELLED
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([departmentId, status])
}

model Encounter {
  id              String          @id @default(uuid())
  encounterNumber String          @unique
  appointmentId   String          @unique
  appointment     Appointment     @relation(fields: [appointmentId], references: [id])
  patientId       String
  patient         PatientProfile  @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          DoctorProfile   @relation(fields: [doctorId], references: [id])
  startTime       DateTime        @default(now())
  endTime         DateTime?
  status          EncounterStatus @default(IN_PROGRESS)
  type            EncounterType   @default(OUTPATIENT)
  chiefComplaint  String
  clinicalNotes   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vitalSigns      VitalSigns[]
  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  invoices        Invoice[]

  @@index([patientId])
  @@index([doctorId])
}

model VitalSigns {
  id                 String         @id @default(uuid())
  encounterId        String
  encounter          Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId          String
  patient            PatientProfile @relation(fields: [patientId], references: [id])
  recordedByUserId   String
  recordedAt         DateTime       @default(now())
  systolicBp         Int            // mmHg
  diastolicBp        Int            // mmHg
  heartRate          Int            // bpm
  respiratoryRate    Int?           // breaths/min
  temperature        Decimal?       @db.Decimal(4, 1) // Celsius
  oxygenSaturation   Int?           // SpO2 %
  heightCm           Decimal?       @db.Decimal(5, 2)
  weightKg           Decimal?       @db.Decimal(5, 2)
  bmi                Decimal?       @db.Decimal(4, 1)
  notes              String?

  @@index([encounterId])
  @@index([patientId])
}

model Diagnosis {
  id             String         @id @default(uuid())
  encounterId    String
  encounter      Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id])
  doctorId       String
  icdCode        String
  icdDescription String
  type           DiagnosisType  @default(PRIMARY)
  confidence     String         @default("CONFIRMED")
  notes          String?
  diagnosedAt    DateTime       @default(now())

  @@index([encounterId])
  @@index([patientId])
  @@index([icdCode])
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique
  encounterId        String
  encounter          Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId          String
  patient            PatientProfile     @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             DoctorProfile      @relation(fields: [doctorId], references: [id])
  status             PrescriptionStatus @default(ACTIVE)
  instructions       String?
  startDate          DateTime           @default(now())
  endDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              PrescriptionItem[]

  @@index([encounterId])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String       // "500mg"
  route          String       @default("Oral")
  frequency      String       // "BID" / "Twice daily"
  durationDays   Int
  quantity       Int
  refillsAllowed Int          @default(0)
  precautions    String?

  @@index([prescriptionId])
}

model LabOrder {
  id                 String         @id @default(uuid())
  orderNumber        String         @unique
  encounterId        String
  encounter          Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId          String
  patient            PatientProfile @relation(fields: [patientId], references: [id])
  orderingDoctorId   String
  orderingDoctor     DoctorProfile  @relation(fields: [orderingDoctorId], references: [id])
  status             LabOrderStatus @default(PENDING)
  priority           LabPriority    @default(ROUTINE)
  orderDate          DateTime       @default(now())
  testPanelName      String
  clinicalIndication String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  results            LabResult[]

  @@index([encounterId])
  @@index([patientId])
  @@index([status])
}

model LabResult {
  id                String            @id @default(uuid())
  labOrderId        String
  labOrder          LabOrder          @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  patientId         String
  patient           PatientProfile    @relation(fields: [patientId], references: [id])
  technicianUserId  String?
  validatedByUserId String?
  testName          String
  testCode          String            // LOINC or internal code
  measuredValue     String
  unit              String
  referenceRangeLow String?
  referenceRangeHigh String?
  interpretation    LabInterpretation @default(NORMAL)
  status            String            @default("FINAL") // PRELIMINARY, FINAL, CORRECTED
  specimenType      String            @default("Blood - Serum")
  remarks           String?
  completedAt       DateTime          @default(now())
  validatedAt       DateTime?

  @@index([labOrderId])
  @@index([patientId])
}

model Invoice {
  id            String          @id @default(uuid())
  invoiceNumber String          @unique
  patientId     String
  patient       PatientProfile  @relation(fields: [patientId], references: [id])
  encounterId   String?
  encounter     Encounter?      @relation(fields: [encounterId], references: [id])
  status        InvoiceStatus   @default(ISSUED)
  totalAmount   Decimal         @db.Decimal(10, 2)
  paidAmount    Decimal         @default(0.00) @db.Decimal(10, 2)
  balanceAmount Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  issuedAt      DateTime        @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items         InvoiceItem[]
  payments      Payment[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  category    InvoiceCategory
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  totalPrice  Decimal         @db.Decimal(10, 2)

  @@index([invoiceId])
}

model Payment {
  id                   String        @id @default(uuid())
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId            String
  paymentMethod        PaymentMethod @default(SIMULATED)
  amount               Decimal       @db.Decimal(10, 2)
  transactionReference String?
  status               String        @default("SUCCESS")
  paymentDate          DateTime      @default(now())

  @@index([invoiceId])
  @@index([patientId])
}

model ConsentRecord {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentType      ConsentType
  granted          Boolean        @default(true)
  grantedToRole    Role?
  grantedToUserId  String?
  grantedAt        DateTime       @default(now())
  revokedAt        DateTime?
  revocationReason String?
  expiresAt        DateTime?
  ipAddress        String?

  @@index([patientId, consentType])
}

model AuditLog {
  id                   String   @id @default(uuid())
  action               String   // e.g. "RECORD_ACCESS", "APPOINTMENT_CREATE", "PRESCRIPTION_DISPENSE"
  entityName           String   // e.g. "PatientProfile", "Encounter", "LabResult"
  entityId             String?
  performedByUserId    String
  user                 User     @relation(fields: [performedByUserId], references: [id])
  userRole             Role
  ipAddress            String?
  userAgent            String?
  details              String?  // JSON stringified details
  timestamp            DateTime @default(now())
  requestCorrelationId String?

  @@index([performedByUserId])
  @@index([entityName, entityId])
  @@index([timestamp])
  @@index([action])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  metadata  String?             // JSON string
  createdAt DateTime            @default(now())

  @@index([userId, status])
}
